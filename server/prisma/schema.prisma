generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  PRIVATE
  GROUP
}

enum SenderType {
  USER
  BOT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  isBot     Boolean  @default(false)
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatMembers   ChatMember[]
  messagesSent  Message[]     @relation("MessageSender")
  readReceipts  MessageRead[]

   sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  @@map("users")
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType @default(PRIVATE)
  name      String?  // used for group chats
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]

  @@map("chats")
}

model ChatMember {
  id       String   @id @default(uuid())
  chatId   String
  userId   String
  joinedAt DateTime @default(now())
  isAdmin  Boolean  @default(false)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@map("chat_members")
}

model Message {
  id         String     @id @default(uuid())
  chatId     String
  senderId   String
  senderType SenderType @default(USER)
  content    String
  createdAt  DateTime   @default(now())

  chat   Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reads  MessageRead[]

  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reads")
}


model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@map("friendships")
}